{
  "services": {
    "qass-machine1": {
      "build": ".",
      "command": [
        "python3",
        "main.py",
        "configs/config_machine1.yaml"
      ],
      "environment": {
        "HEALTH_PORT": 8081,
        "QASS_LOG_FILE": "qass_machine1.log"
      },
      "image": "qass-service:13.0",
      "network_mode": "host",
      "restart": "always",
      "volumes": [
        "qass_state:/app/state",
        "qass_logs:/app/logs"
      ]
    },
    "qass-machine2": {
      "build": ".",
      "command": [
        "python3",
