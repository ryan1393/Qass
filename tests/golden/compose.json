        "QASS_LOG_FILE": "qass_machine2.log"
      },
      "image": "qass-service:13.0",
      "network_mode": "host",
      "restart": "always",
      "volumes": [
        "qass_state:/app/state",
        "qass_logs:/app/logs"
      ]
    },
    "qass-machine3": {
